## 5. Query Thread Implementation (`{module}svc_query.go`)

Handles all read operations. Owns the cache.

### 5.1 Cache Preload on Startup (CRITICAL)

**Rule:** The cache MUST be fully loaded from the database BEFORE the query thread starts processing requests.

**Pattern:**
1. Load cache synchronously at the start of `queryRunThread()`
2. Retry indefinitely on failure (service cannot function without cache)
3. Only after successful load, start processing channel messages
4. Periodic refresh runs in the background via ticker

**Why this matters:**
- Ensures all read operations have data available immediately
- Prevents empty responses during startup window
- Guarantees consistency between cache and database state

```go
package foosvc

import (
    "context"
    "fmt"
    "time"

    "<PROJECT>/internal/models"
)

func (o *FooSvc) queryRunThread() {
    o.logger.Println("FooSvc: queryRunThread started")
    ctx := context.Background()

    // ============================================
    // CRITICAL: Preload cache BEFORE processing requests
    // ============================================
    // Retry indefinitely until cache is loaded.
    // Service cannot serve reads without populated cache.
    for {
        err := o.cache.loadFromDB(ctx, o.db)
        if err == nil {
            break
        }
        o.logger.Printf("foo cache initial load error: %v (retrying in 2s)", err)
        time.Sleep(2 * time.Second)
    }
    // ============================================

    // Periodic refresh from config
    refresh := time.Duration(*o.cfg.Cache.SyncIntervalSecs) * time.Second
    ticker := time.NewTicker(refresh)
    defer ticker.Stop()

    // Main event loop - only starts AFTER cache is loaded
    for o.svcState.Load() == 1 {
        select {
        case req := <-o.queryCh:
            o.queryHandleReq(req)
        case <-ticker.C:
            _ = o.cache.loadFromDB(ctx, o.db)
        }
    }
    o.logger.Println("FooSvc: queryRunThread stopped")
}

func (o *FooSvc) queryHandleReq(req *runMsgReq) {
    t, _ := req.msgType.(queryType)
    switch t {
    case queryGetByID:
        o.queryHandleGetByID(req)
    case queryList:
        o.queryHandleList(req)
    case queryIntCacheAdd:
        if f, ok := req.msgData.(*models.Foo); ok {
            o.cache.add(f)
        }
        req.rspCh <- &runMsgRsp{}
    case queryIntCacheUpdate:
        if f, ok := req.msgData.(*models.Foo); ok {
            o.cache.update(f)
        }
        req.rspCh <- &runMsgRsp{}
    case queryIntCacheRemove:
        if id, ok := req.msgData.(string); ok {
            o.cache.remove(id)
        }
        req.rspCh <- &runMsgRsp{}
    case queryIntCacheRefresh:
        _ = o.cache.loadFromDB(context.Background(), o.db)
        req.rspCh <- &runMsgRsp{}
    default:
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("unknown query type")}
    }
}

func (o *FooSvc) queryHandleGetByID(req *runMsgReq) {
    data := req.msgData.(*GetByIDReq)
    foo, ok := o.cache.getByID(data.ID)
    if !ok {
        req.rspCh <- &runMsgRsp{data: nil}
        return
    }
    req.rspCh <- &runMsgRsp{data: foo}
}

func (o *FooSvc) queryHandleList(req *runMsgReq) {
    data := req.msgData.(*ListReq)
    items := o.cache.listByAccount(data.AccountID)
    if items == nil {
        items = []*models.Foo{}
    }
    req.rspCh <- &runMsgRsp{data: items}
}
```

