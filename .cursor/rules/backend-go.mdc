## 8. Handler Implementation (`{module}hdlr/{module}hdlr.go`)

HTTP handlers are thin wrappers that:
1. Parse request
2. Extract context (AccountID, UserID)
3. Call service
4. Return response

```go
package foohdlr

import (
    "encoding/json"
    "log"
    "net/http"

    "github.com/go-chi/chi/v5"

    "<PROJECT>/internal/apiserver"
    "<PROJECT>/internal/middleware"
    "<PROJECT>/internal/modules/foo/foosvc"
)

type FooHdlr struct {
    svc    *foosvc.FooSvc
    logger *log.Logger
}

func NewFooHdlr(svc *foosvc.FooSvc, logger *log.Logger) *FooHdlr {
    return &FooHdlr{svc: svc, logger: logger}
}

// RegisterRoutes implements apiserver.RouteRegistrar.
func (h *FooHdlr) RegisterRoutes(r chi.Router) {
    r.Get("/", h.list)
    r.Get("/{id}", h.getByID)
    r.With(middleware.RequirePermission("foo", "create")).Post("/", h.create)
    r.With(middleware.RequirePermission("foo", "update")).Put("/{id}", h.update)
    r.With(middleware.RequirePermission("foo", "delete")).Delete("/{id}", h.delete)
}

// --- List ---

func (h *FooHdlr) list(w http.ResponseWriter, r *http.Request) {
    accountID := middleware.GetAccountID(r.Context())
    userID := middleware.GetUserID(r.Context())

    items, err := h.svc.List(&foosvc.ListReq{AccountID: accountID, UserID: userID})
    if err != nil {
        h.logger.Printf("list error: %v", err)
        apiserver.RespondInternalError(w, "Failed to list items")
        return
    }

    apiserver.RespondOK(w, items)
}

// --- GetByID ---

func (h *FooHdlr) getByID(w http.ResponseWriter, r *http.Request) {
    id := chi.URLParam(r, "id")
    accountID := middleware.GetAccountID(r.Context())
    userID := middleware.GetUserID(r.Context())

    item, err := h.svc.GetByID(&foosvc.GetByIDReq{ID: id, AccountID: accountID, UserID: userID})
    if err != nil {
        h.logger.Printf("getByID error: %v", err)
        apiserver.RespondInternalError(w, "Failed to get item")
        return
    }
    if item == nil {
        apiserver.RespondNotFound(w)
        return
    }

    apiserver.RespondOK(w, item)
}

// --- Create ---

type createReq struct {
    Name *string `json:"name"`
}

func (h *FooHdlr) create(w http.ResponseWriter, r *http.Request) {
    var req createReq
    if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.Name == nil {
        apiserver.RespondBadRequest(w, "invalid_body", "name is required")
        return
    }

    accountID := middleware.GetAccountID(r.Context())
    userID := middleware.GetUserID(r.Context())

    item, err := h.svc.CreateFoo(&foosvc.CreateFooReq{
        Name:      *req.Name,
        AccountID: accountID,
        UserID:    userID,
    })
    if err != nil {
        h.logger.Printf("create error: %v", err)
        apiserver.RespondInternalError(w, "Failed to create item")
        return
    }

    apiserver.RespondCreated(w, item)
}

// --- Update ---

type updateReq struct {
    Name *string `json:"name"`
}

func (h *FooHdlr) update(w http.ResponseWriter, r *http.Request) {
    id := chi.URLParam(r, "id")
    var req updateReq
    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
        apiserver.RespondBadRequest(w, "invalid_body", "Invalid request body")
        return
    }

    accountID := middleware.GetAccountID(r.Context())
    userID := middleware.GetUserID(r.Context())

    item, err := h.svc.UpdateFoo(&foosvc.UpdateFooReq{
        ID:        id,
        Name:      req.Name,
        AccountID: accountID,
        UserID:    userID,
    })
    if err != nil {
        h.logger.Printf("update error: %v", err)
        apiserver.RespondInternalError(w, "Failed to update item")
        return
    }

    apiserver.RespondOK(w, item)
}

// --- Delete ---

func (h *FooHdlr) delete(w http.ResponseWriter, r *http.Request) {
    id := chi.URLParam(r, "id")
    accountID := middleware.GetAccountID(r.Context())
    userID := middleware.GetUserID(r.Context())

    err := h.svc.DeleteFoo(&foosvc.DeleteFooReq{ID: id, AccountID: accountID, UserID: userID})
    if err != nil {
        h.logger.Printf("delete error: %v", err)
        apiserver.RespondInternalError(w, "Failed to delete item")
        return
    }

    apiserver.RespondNoContent(w)
}
```

