## 6. Cache Implementation (`{module}_cache.go`)

Only the query goroutine accesses the cache (no locks needed).

```go
package foosvc

import (
	"context"
	"fmt"

	"<PROJECT>/internal/cachenotify"
	"<PROJECT>/internal/database"
	"<PROJECT>/internal/models"
)

type fooCache struct {
    byID        map[string]*models.Foo
    byAccountID map[string][]*models.Foo
    logger      *log.Logger
}

func newFooCache(logger *log.Logger) *fooCache {
    return &fooCache{
        byID:        make(map[string]*models.Foo),
        byAccountID: make(map[string][]*models.Foo),
        logger:      logger,
    }
}

func (c *fooCache) loadFromDB(ctx context.Context, db *database.PGSQLSvc) error {
    pool, err := db.GetDBInstance(ctx)
    if err != nil {
        return err
    }
    rows, err := pool.Query(ctx,
        `SELECT id, name, account_id, status, created_at, updated_at FROM foos`)
    if err != nil {
        return err
    }
    defer rows.Close()

    byID := make(map[string]*models.Foo)
    byAccountID := make(map[string][]*models.Foo)

    for rows.Next() {
        f := &models.Foo{}
        if err := rows.Scan(&f.ID, &f.Name, &f.AccountID, &f.Status, &f.CreatedAt, &f.UpdatedAt); err != nil {
            return err
        }
        byID[f.ID] = f
        byAccountID[f.AccountID] = append(byAccountID[f.AccountID], f)
    }

    c.byID = byID
    c.byAccountID = byAccountID
    c.logger.Printf("foo cache loaded: %d items", len(byID))
    return nil
}

func (c *fooCache) getByID(id string) (*models.Foo, bool) {
    f, ok := c.byID[id]
    if !ok || f == nil {
        return nil, false
    }
    // Return a copy to prevent mutation
    fcopy := *f
    return &fcopy, true
}

func (c *fooCache) listByAccount(accountID string) []*models.Foo {
    items := c.byAccountID[accountID]
    result := make([]*models.Foo, len(items))
    for i, f := range items {
        fcopy := *f
        result[i] = &fcopy
    }
    return result
}

func (c *fooCache) add(f *models.Foo) {
    fcopy := *f
    c.byID[f.ID] = &fcopy
    c.byAccountID[f.AccountID] = append(c.byAccountID[f.AccountID], &fcopy)
}

func (c *fooCache) update(f *models.Foo) {
    existing := c.byID[f.ID]
    if existing == nil {
        return
    }
    existing.Name = f.Name
    existing.Status = f.Status
    existing.UpdatedAt = f.UpdatedAt
}

func (c *fooCache) remove(id string) {
    f := c.byID[id]
    if f == nil {
        return
    }
    delete(c.byID, id)
    // Remove from account index
    items := c.byAccountID[f.AccountID]
    for i, item := range items {
        if item.ID == id {
            c.byAccountID[f.AccountID] = append(items[:i], items[i+1:]...)
            break
        }
    }
}
```

