## 4. Ops Thread Implementation (`{module}svc_ops.go`)

Handles all write operations (CREATE, UPDATE, DELETE).

### 4.1 Loop Pattern Options

| Pattern | When to Use |
|---------|-------------|
| `for req := range o.opsCh` | **Preferred.** Simple, clean. Channel close triggers exit. |
| `select` with ticker | When periodic background tasks are needed (cleanup, health checks). |

**Note:** The range pattern relies on channel close for shutdown. Ensure `run()` closes `opsCh` during graceful shutdown, or use the select pattern if state-based shutdown is required.

```go
package foosvc

import (
    "context"
    "fmt"
    "time"

    "<PROJECT>/internal/cachenotify"
    "<PROJECT>/internal/database"
    "<PROJECT>/internal/models"
)

func notifyRefresh(db *database.PGSQLSvc) {
    ctx := context.Background()
    pool, err := db.GetDBInstance(ctx)
    if err != nil {
        return
    }
    _, _ = pool.Exec(ctx, "NOTIFY "+cachenotify.ChannelFoo)
}

// --- Option A: Range loop (preferred for ops thread) ---
// Simpler, blocks until channel closes. Use when no periodic tasks needed.

func (o *FooSvc) opsRunThread() {
    o.logger.Println("FooSvc: opsRunThread started")
    defer o.logger.Println("FooSvc: opsRunThread stopped")

    for req := range o.opsCh {
        var rsp *runMsgRsp
        switch req.msgType {
        case opsCreate:
            rsp = o.handleCreate(req.msgData.(*CreateFooReq))
        case opsUpdate:
            rsp = o.handleUpdate(req.msgData.(*UpdateFooReq))
        case opsDelete:
            rsp = o.handleDelete(req.msgData.(*DeleteFooReq))
        default:
            rsp = &runMsgRsp{err: fmt.Errorf("unknown ops type: %v", req.msgType)}
        }
        req.rspCh <- rsp
    }
}

// --- Option B: Select with ticker ---
// Use when you need periodic tasks (e.g., background cleanup, health checks).

func (o *FooSvc) opsRunThreadWithTicker() {
    o.logger.Println("FooSvc: opsRunThread started")
    ticker := time.NewTicker(time.Second)
    defer ticker.Stop()

    for o.svcState.Load() == 1 {
        select {
        case req := <-o.opsCh:
            o.opsHandleReq(req)
        case <-ticker.C:
            // Periodic task here if needed
        }
    }
    o.logger.Println("FooSvc: opsRunThread stopped")
}

// --- Handler dispatch (for Option B) ---

func (o *FooSvc) opsHandleReq(req *runMsgReq) {
    switch req.msgType.(opsType) {
    case opsCreate:
        o.opsHandleCreate(req)
    case opsUpdate:
        o.opsHandleUpdate(req)
    case opsDelete:
        o.opsHandleDelete(req)
    default:
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("unknown ops type")}
    }
}

func (o *FooSvc) opsHandleCreate(req *runMsgReq) {
    data := req.msgData.(*CreateFooReq)
    ctx := context.Background()

    pool, err := o.db.GetDBInstance(ctx)
    if err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("db: %w", err)}
        return
    }

    tx, err := pool.Begin(ctx)
    if err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("begin tx: %w", err)}
        return
    }
    defer tx.Rollback(ctx) //nolint:errcheck

    // Set session context for RLS
    if _, err := tx.Exec(ctx, "SELECT set_session_context($1, $2)", data.AccountID, data.UserID); err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("set context: %w", err)}
        return
    }

    var foo models.Foo
    err = tx.QueryRow(ctx,
        `INSERT INTO foos (name, account_id)
         VALUES ($1, $2)
         RETURNING id, name, account_id, status, created_at, updated_at`,
        data.Name, data.AccountID,
    ).Scan(&foo.ID, &foo.Name, &foo.AccountID, &foo.Status, &foo.CreatedAt, &foo.UpdatedAt)
    if err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("insert: %w", err)}
        return
    }

    if err := tx.Commit(ctx); err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("commit: %w", err)}
        return
    }

    if err := tx.Commit(ctx); err != nil {
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("commit: %w", err)}
        return
    }

    // Notify OTHER instances FIRST (they'll refresh from DB)
    notifyRefresh(o.db)

    // Then update LOCAL cache (optimization)
    rspCh := make(chan *runMsgRsp, 1)
    o.queryCh <- &runMsgReq{msgType: queryIntCacheAdd, msgData: &foo, rspCh: rspCh}
    <-rspCh

    o.logger.Printf("Foo created: %s (%s)", foo.Name, foo.ID)
    req.rspCh <- &runMsgRsp{data: &foo}
}
```

