## 3. Service Layer Implementation

### 3.1 Service Struct (`{module}svc.go`)

```go
package foosvc

import (
    "fmt"
    "log"
    "sync/atomic"
    "time"

    "<PROJECT>/internal/config"
    "<PROJECT>/internal/database"
    "<PROJECT>/internal/models"
)

// --- Message types ---

type opsType string

const (
    opsCreate opsType = "create"
    opsUpdate opsType = "update"
    opsDelete opsType = "delete"
)

type queryType string

const (
    queryGetByID         queryType = "get_by_id"
    queryList            queryType = "list"
    queryIntCacheAdd     queryType = "int_cache_add"
    queryIntCacheUpdate  queryType = "int_cache_update"
    queryIntCacheRemove  queryType = "int_cache_remove"
    queryIntCacheRefresh queryType = "int_cache_refresh"
)

type runMsgReq struct {
    msgType interface{}
    msgData interface{}
    rspCh   chan *runMsgRsp
}

type runMsgRsp struct {
    err  error
    data interface{}
}

// --- Service ---

type StateCallback struct {
    Started func()
    Stopped func()
}

type FooSvc struct {
    cfg           *config.ConfigServer
    db            *database.PGSQLSvc
    cache         *fooCache
    stateCallback *StateCallback
    logger        *log.Logger

    opsCh       chan *runMsgReq
    queryCh     chan *runMsgReq
    activeCalls *atomic.Int64
    svcState    *atomic.Uint64 // 0: stopped, 1: running, 2: stopping
}

func NewFooSvc(cfg *config.ConfigServer, db *database.PGSQLSvc, cb *StateCallback, logger *log.Logger) *FooSvc {
    return &FooSvc{
        cfg:           cfg,
        db:            db,
        cache:         newFooCache(logger),
        stateCallback: cb,
        logger:        logger,
        opsCh:         make(chan *runMsgReq, *cfg.Cache.OpsChSize),
        queryCh:       make(chan *runMsgReq, *cfg.Cache.QueryChSize),
        activeCalls:   &atomic.Int64{},
        svcState:      &atomic.Uint64{},
    }
}
```

### 3.2 Lifecycle Methods

```go
func (o *FooSvc) Start() error {
    if !o.svcState.CompareAndSwap(0, 1) {
        return fmt.Errorf("foo service already started")
    }
    go func() {
        if o.stateCallback != nil && o.stateCallback.Started != nil {
            o.stateCallback.Started()
        }
        o.run()
        if o.stateCallback != nil && o.stateCallback.Stopped != nil {
            o.stateCallback.Stopped()
        }
    }()
    return nil
}

func (o *FooSvc) Stop() {
    o.svcState.CompareAndSwap(1, 2)
}

func (o *FooSvc) sendReq(ch chan *runMsgReq, msgType interface{}, data interface{}) (interface{}, error) {
	if o.svcState.Load() != 1 {
		return nil, fmt.Errorf("service not running")
	}
	o.activeCalls.Add(1)
	defer o.activeCalls.Add(-1)
	rspCh := make(chan *runMsgRsp, 1)
	ch <- &runMsgReq{msgType: msgType, msgData: data, rspCh: rspCh}
	rsp := <-rspCh
	return rsp.data, rsp.err
}

func (o *FooSvc) run() {
    o.logger.Println("FooSvc: run started")
    go o.opsRunThread()
    go o.queryRunThread()

    ticker := time.NewTicker(time.Second)
    defer ticker.Stop()
    for o.svcState.Load() == 1 {
        <-ticker.C
    }

    for o.activeCalls.Load() > 0 || len(o.opsCh) > 0 || len(o.queryCh) > 0 {
        o.drainChannel(o.opsCh)
        o.drainChannel(o.queryCh)
        time.Sleep(100 * time.Millisecond)
    }
    o.logger.Println("FooSvc: run stopped")
}

func (o *FooSvc) drainChannel(ch chan *runMsgReq) {
    for len(ch) > 0 {
        req := <-ch
        req.rspCh <- &runMsgRsp{err: fmt.Errorf("service stopped")}
    }
}
```

